{
  "schemaVersion": 2,
  "id": "4398d440-4e4f-4137-b25e-303bfeb2a276",
  "slug": "buzznode",
  "name": "Buzznode",
  "publisher": "PDP Architect",
  "description": "A persistent browser-accessible Linux desktop for one Buzz agent, with terminal, filesystem, browser, and Codex, Claude Code, or Goose runtime support.",
  "tags": [
    "DEVELOPMENT",
    "TERMINAL",
    "AUTONOMOUS"
  ],
  "media": {
    "icon": "icon.png",
    "cover": "screenshot.png",
    "screenshots": [
      {
        "source": "screenshot.png",
        "alt": "Fresh Buzznode desktop with its agent enrollment terminal"
      }
    ]
  },
  "interfaces": {
    "desktop": {
      "kind": "kasmweb",
      "port": 6901,
      "path": "/"
    }
  },
  "memory": "4g",
  "sharedMemory": "1g",
  "environment": {
    "DESKTOP_VNC_STATS": "false"
  },
  "mounts": [
    {
      "name": "workspace",
      "target": "/workspace"
    },
    {
      "name": "private/config",
      "target": "/home/agent/.config"
    },
    {
      "name": "private/data",
      "target": "/home/agent/.local/share"
    },
    {
      "name": "private/buzz",
      "target": "/home/agent/.buzz"
    },
    {
      "name": "private/codex",
      "target": "/home/agent/.codex"
    },
    {
      "name": "private/claude",
      "target": "/home/agent/.claude"
    }
  ]
}
