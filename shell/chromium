#!/bin/bash
# chromium - wrapper that launches Google Chrome with container-safe flags.
# Placed in /usr/local/bin to override any system chromium and provide a
# single entry point for menus, xdg-open, kitty, and CLI tools.

# Only use the GPU when a render node is present *and* this user can open it.
# With one Chrome can composite and rasterize on the GPU, which removes the
# largest source of repaint work on this desktop. A passed-through node is
# normally root:render 0660 and this image has no matching group, so testing
# for presence alone points Chrome's GPU process at a device it cannot open.
gpu_args=(--disable-gpu --disable-software-rasterizer)
for node in /dev/dri/renderD*; do
    if [ -r "$node" ] && [ -w "$node" ]; then
        gpu_args=(--ignore-gpu-blocklist --enable-gpu-rasterization)
        break
    fi
done

exec /opt/google/chrome/google-chrome \
    --no-sandbox \
    --test-type \
    "${gpu_args[@]}" \
    --disable-dev-shm-usage \
    --no-first-run \
    --no-default-browser-check \
    --disable-infobars \
    --force-dark-mode \
    --enable-features=WebContentsForceDark \
    "$@"
